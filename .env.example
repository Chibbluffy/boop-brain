OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b              # fast default model for ordinary chat + gate 2 - must be a model already pulled on this host
OLLAMA_RELEVANCE_MODEL=llama3.2:3b    # small/fast model for the jump-in relevance check - must also be a model already pulled (defaults to OLLAMA_MODEL if unset)
OLLAMA_EMBED_MODEL=nomic-embed-text   # embedding-capable model - must be pulled server-side (`ollama pull nomic-embed-text`)
OLLAMA_NUM_CTX=8192                   # context window requested per call on the fast path - raise if prompts (persona+history+lore) get truncated; a bigger HISTORY_MAX_TURNS below needs a bigger value here too
OLLAMA_SMART_MODEL=qwen3-vl:8b        # escalation-path model (vision + tools) - used when heuristics.detect_escalation() fires; defaults to OLLAMA_MODEL if unset
OLLAMA_SMART_NUM_CTX=16384            # larger context budget for the smart path - tool schemas + tool results + fetched page text can be verbose
OLLAMA_MAX_REPLY_TOKENS=220           # hard cap on reply length (num_predict) - keeps responses from rambling; lower this further for terser replies

BRAVE_API_KEY=changeme                # https://api.search.brave.com - free tier ~2000 queries/month, used by the search_web tool
TOOL_MAX_ROUNDS=3                     # max tool-call round-trips before forcing a final plain-text answer
FETCH_URL_MAX_CHARS=4000              # truncate fetched webpage text to this many characters before feeding to the model

QDRANT_HOST=qdrant                   # container/service name reachable on boop-brain
QDRANT_PORT=6333
QDRANT_COLLECTION=boopbot_lore
QDRANT_EMBED_DIMS=768                # MUST match OLLAMA_EMBED_MODEL's actual output dims
QDRANT_API_KEY=                      # set if Qdrant requires an API key (e.g. QDRANT__SERVICE__API_KEY set on the Qdrant container); leave blank if unauthenticated
QDRANT_URL=                          # override instead of deriving from host/port (e.g. for Qdrant Cloud's https:// URL); leave blank to use http://QDRANT_HOST:QDRANT_PORT

REDIS_HOST=redis
REDIS_PORT=6379
HISTORY_MAX_TURNS=12                 # user+assistant pairs kept per channel - raising this significantly needs a bigger OLLAMA_NUM_CTX above too
HISTORY_TTL_SECONDS=21600            # 6h idle-channel expiry

CHATBOT_CONTEXT_FILE=/app/persona/chatbot_context.txt
LORE_TOP_K=5                         # memories retrieved per scope per generation call

IDLE_SWEEP_INTERVAL_SECONDS=300      # how often the background sweep checks for idle channels to summarize
IDLE_SUMMARY_THRESHOLD_SECONDS=600   # remaining history TTL that counts as "about to expire, summarize now" - keep well above the interval above

BRAIN_SHARED_SECRET=changeme         # must match BRAIN_SHARED_SECRET in BoopBot/.env
